# Supabase project URL and keys — find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key — SECRET, server-side only. Never expose to the browser.
# Used only in API routes for admin user management (creating/deleting auditors & branch users).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
